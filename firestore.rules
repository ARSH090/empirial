rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an active admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.is_active == true;
    }

    // General fallback: only admins can write, anyone can read static data
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // Referrals subcollection
      match /referrals/{refId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
      
      // Purchased accounts subcollection
      match /purchasedAccounts/{accId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }

      // Redeemed rewards subcollection
      match /redeemedRewards/{redId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Referral Visitors collection (Anonymous tracking)
    match /referralVisitors/{visitorId} {
      allow read: if true;
      allow create: if request.resource.data.visitorId == visitorId && request.resource.data.status == 'anonymous';
      allow update: if (request.resource.data.status == 'registered' && request.resource.data.registeredUserId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
